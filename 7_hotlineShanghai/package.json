{
  "name": "hotline-shanghai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hotline Shanghai / 热线上海 — Hotline Miami-style 顶视角像素射击 + 1937 上海抗战 + 2D Radiance Cascades 实时光影。",
  "scripts": {
    "dev": "vite --port 5184 --host",
