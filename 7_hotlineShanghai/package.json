{
  "name": "hotline-shanghai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hotline Shanghai / 热线上海 — Hotline Miami-style 顶视角像素射击 + 1937 上海抗战 + 2D Radiance Cascades 实时光影。",
  "scripts": {
    "dev": "vite --port 5184 --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5184",
    "typecheck": "tsc -b --noEmit",
    "sprites:process": "node scripts/process-intro-sprites.mjs",
    "intro-assets:check": "node scripts/process-intro-sprites.mjs --check",
    "intro-polish:check": "node scripts/intro-polish-check.mjs",
    "intro-usability:check": "npm run combat-loop:check && npm run e2e:playtest",
    "light-break:check": "node scripts/light-break-check.mjs",
    "combat-loop:check": "node scripts/combat-loop-check.mjs",
    "phase-playtest": "node scripts/playtest.mjs",
    "e2e:playtest": "npm exec --offline --yes --package=playwright -- node scripts/run-e2e.mjs",
    "rc-lab:check": "npm exec --offline --yes --package=playwright -- node scripts/run-e2e.mjs scripts/playwright.rc-lab.config.mjs",
    "rc-intro-copy:check": "npm run rc-lab:check",
    "self-play:check": "npm exec --offline --yes --package=playwright -- node scripts/run-e2e.mjs scripts/playwright.self-play.config.mjs",
    "bug-probe:check": "npm exec --offline --yes --package=playwright -- node scripts/run-e2e.mjs scripts/playwright.bug-probe.config.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
